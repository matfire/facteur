{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static site on Cloudflare Workers. `bun run build` writes dist/client; there is no Worker script.
  "name": "facteur-web",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist/client",
    // Pages are built as docs/effect/index.html. Serve them at /docs/effect, matching the
    // canonical URLs and sitemap, and redirect /docs/effect/ there.
    "html_handling": "drop-trailing-slash",
    // Missing URLs get dist/client/404.html with a 404 status.
    "not_found_handling": "404-page",
  },
  // Attaches facteur.dev to this Worker on deploy. The zone must be on the same Cloudflare account.
  "routes": [{ "pattern": "facteur.dev", "custom_domain": true }],
  // Workers Builds runs `wrangler preview` for non-production branches (PRs), which needs this
  // block. It can stay empty: assets and compatibility settings above apply to previews too.
  "previews": {},
  // Gives each PR preview a <preview-name>-facteur-web.<subdomain>.workers.dev URL.
  "preview_urls": true,
}
